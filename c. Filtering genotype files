#!/bin/bash

#1. filter genoytpe file according to a list of samples
#create a txt with list of samples to be filtered, one in each line

module load bcftools
bcftools view --samples-file $samples_to_keep.txt $input.vcf > $output.vcf

#2. filter genoytpe file according to a list of SNPs
plink --vcf $input --extract $snps_to_keep.txt --keep-allele-order --allow-extra-chr --chr-set 46 --allow-no-sex --double-id --recode vcf --out $output


