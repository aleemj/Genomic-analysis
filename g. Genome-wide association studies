cd /home/users/nus/e1583429/scratch/esativa_analysis/GWAS/
# Define your file prefixes
BFILE=<insert bed file prefix>
KINSHIP=<insert kinship file>
TRAIT_FILE=<insert list of trait names in order>
EIGEN="insert PCA results"

# Initialize a counter for the phenotype column index
# GEMMA -n 1 corresponds to the 6th column in the .fam file
INDEX=1

# Read the trait names file line by line
while IFS= read -r TRAIT_NAME || [[ -n "$TRAIT_NAME" ]]; do
    # Skip empty lines if any
    if [ -z "$TRAIT_NAME" ]; then continue; fi

    echo "-------------------------------------------------------"
    echo "Running GWAS for Trait: $TRAIT_NAME (Column Index: $INDEX)"
    echo "-------------------------------------------------------"

    # Execute GEMMA
    # -lmm 4 runs Wald, Likelihood Ratio, and Score tests
    /home/users/nus/e1583429/gemma -bfile $BFILE \
          -k $KINSHIP \
          -lmm 4 \
          -c $EIGEN \
          -n $INDEX \
          -o "$TRAIT_NAME"

    # Increment the index for the next trait column
    ((INDEX++))

done < "$TRAIT_FILE"

echo "All GWAS runs complete. Check the /output folder."

